{
  "name": "technoprime",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "shop",
    "packages/*"
  ],
  "scripts": {
    "up": "bash ./scripts/local-up.sh",
    "down": "bash ./scripts/local-down.sh",
    "status": "bash ./scripts/local-status.sh",
    "dev:crm": "npm run dev --workspace frontend",
    "dev:shop": "npm run dev --workspace shop",
    "dev:backend": "npm run start:dev --workspace backend",
    "build:crm": "npm run build --workspace frontend",
    "build:shop": "npm run build --workspace shop",
    "build:backend": "npm run build --workspace backend",
    "build": "npm run build --workspaces --if-present",
    "start:crm": "npm run start --workspace frontend",
    "start:shop": "npm run start --workspace shop",
    "start:backend": "npm run start:prod --workspace backend"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.15"
    },
    "postcss": "8.5.15",
    "qs": "6.15.2",
    "ws": "8.21.0"
  }
}
